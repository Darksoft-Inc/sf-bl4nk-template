{% extends 'base.html.twig' %}

{% block title %}Terms{% endblock %}

{% block body %}
    <main>
        <h1>Terms</h1>

        <div class="alert alert-warning" role="alert">
            This page is a placeholder. The registration form links to it, and
            the real terms must replace this text before the application
            serves the public.
        </div>

        <p>
            Write the terms of the service this application provides on this
            page. The registration checkbox links to the stable address
            <code>/docs/terms</code>, so a later rewrite of the text changes
            no link. A new language is a template file dropped beside this
            one, such as <code>terms.fr.html.twig</code>.
        </p>
    </main>
{% endblock %}
