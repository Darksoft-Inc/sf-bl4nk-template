{% extends 'base.html.twig' %}

{% block title %}{{ 'app.page.login'|trans }}{% endblock %}

{% block body %}
<main>
    {% if error %}
        <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <p>{{ 'app.login.logged_in_as'|trans({'%identifier%': app.user.userIdentifier}) }} <twig:LogoutLink>{{ 'app.navigation.logout'|trans }}</twig:LogoutLink></p>
    {% endif %}

    <h1>{{ 'app.page.login'|trans }}</h1>

    <form method="post">
        <label for="username">{{ 'app.account.email'|trans }}</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" autocomplete="email" required autofocus>
        <label for="password">{{ 'app.account.password'|trans }}</label>
        <input type="password" name="_password" id="password" autocomplete="current-password" required>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
            <label class="form-check-label" for="remember_me">{{ 'app.login.remember_me'|trans }}</label>
        </div>

        <button type="submit">{{ 'app.navigation.login'|trans }}</button>
    </form>

    <p><a href="{{ path('app_forgot_password_request') }}">{{ 'app.account.forgot_password'|trans }}</a></p>
</main>
{% endblock %}
