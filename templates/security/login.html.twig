{% extends 'base.html.twig' %}

{% block title %}{{ 'app.page.login'|trans }}{% endblock %}

{% block body %}
<main>
    {% if error %}
        <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <p>{{ 'app.login.logged_in_as'|trans({'%identifier%': app.user.userIdentifier}) }} <twig:PostLink href="{{ logout_path() }}" csrfTokenId="logout">{{ 'app.navigation.logout'|trans }}</twig:PostLink></p>
    {% endif %}

    <h1>{{ 'app.page.login'|trans }}</h1>

    {{ form_start(loginForm) }}
        {{ form_row(loginForm._username) }}
        {{ form_row(loginForm._password) }}
        {{ form_row(loginForm._remember_me) }}
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="btn btn-primary">{{ 'app.navigation.login'|trans }}</button>
    {{ form_end(loginForm) }}

    <p><a href="{{ path('app_forgot_password_request') }}">{{ 'app.account.forgot_password'|trans }}</a></p>
</main>
{% endblock %}
