<nav class="navbar navbar-expand-md bg-body-tertiary mb-4">
    <div class="container">
        <a class="navbar-brand d-inline-flex align-items-center" href="{{ path('app_index') }}">
            {{ ux_icon('bi:house-door', {class: 'me-1'}) }}
            {{ 'app.navigation.start'|trans }}
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="{{ 'app.navigation.toggle'|trans }}">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav me-auto mb-2 mb-md-0">
                <li class="nav-item">
                    <a class="nav-link d-inline-flex align-items-center" href="{{ path('app_announcement_index') }}">
                        {{ ux_icon('bi:megaphone', {class: 'me-1'}) }}
                        {{ 'app.navigation.announcements'|trans }}
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-inline-flex align-items-center" href="{{ path('app_map_index') }}">
                        {{ ux_icon('bi:map', {class: 'me-1'}) }}
                        {{ 'app.navigation.maps'|trans }}
                    </a>
                </li>
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center" href="{{ path('app_shared_index') }}">
                            {{ ux_icon('bi:images', {class: 'me-1'}) }}
                            {{ 'app.navigation.shared'|trans }}
                        </a>
                    </li>
                {% endif %}
            </ul>
            <ul class="navbar-nav ms-auto mb-2 mb-md-0">
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link d-inline-flex align-items-center" href="{{ path('app_admin_user_index') }}">
                                {{ ux_icon('bi:gear', {class: 'me-1'}) }}
                                {{ 'app.navigation.admin'|trans }}
                            </a>
                        </li>
                    {% endif %}
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center" href="{{ path('app_profile') }}">
                            {{ ux_icon('bi:person-circle', {class: 'me-1'}) }}
                            {{ 'app.navigation.profile'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        {# The logout link goes through PostLink directly: the
                           LogoutLink recipe forwards the label through a
                           block() expression, which escapes HTML, so an icon
                           label printed as text. The icon stays a literal
                           here so ux:icons:lock keeps discovering it. #}
                        <twig:PostLink
                            href="{{ logout_path() }}"
                            csrfTokenId="logout"
                            class="nav-link d-inline-flex align-items-center">
                            {{ ux_icon('bi:box-arrow-right', {class: 'me-1'}) }}
                            {{ 'app.navigation.logout'|trans }}
                        </twig:PostLink>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center" href="{{ path('app_login') }}">
                            {{ ux_icon('bi:box-arrow-in-right', {class: 'me-1'}) }}
                            {{ 'app.navigation.login'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center" href="{{ path('app_register') }}">
                            {{ ux_icon('bi:person-plus', {class: 'me-1'}) }}
                            {{ 'app.navigation.register'|trans }}
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link d-inline-flex align-items-center" href="{{ path('app_forgot_password_request') }}">
                            {{ ux_icon('bi:key', {class: 'me-1'}) }}
                            {{ 'app.navigation.reset_password'|trans }}
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
