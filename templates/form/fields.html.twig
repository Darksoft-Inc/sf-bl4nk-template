{% use 'bootstrap_5_layout.html.twig' %}

{% block password_widget %}
    {%- set attr = attr|merge({
        'data-password-visibility-target': 'input',
        'spellcheck': 'false',
        'autocapitalize': 'off',
    }) -%}
    <div class="input-group" data-controller="password-visibility">
        {{- parent() -}}
        <button type="button" class="btn btn-outline-secondary" data-action="password-visibility#toggle" aria-controls="{{ id }}">
            <span data-password-visibility-target="show" aria-hidden="true">{{ ux_icon('bi:eye') }}</span>
            <span data-password-visibility-target="hide" aria-hidden="true" hidden>{{ ux_icon('bi:eye-slash') }}</span>
            <span class="visually-hidden" data-password-visibility-target="show">{{ 'app.form.password.show'|trans }}</span>
            <span class="visually-hidden" data-password-visibility-target="hide" hidden>{{ 'app.form.password.hide'|trans }}</span>
        </button>
    </div>
{% endblock %}
