{% do email.setSubject('app.email.verification.subject'|trans) %}
<h1>{{ 'app.email.verification.heading'|trans }}</h1>

<p>
    {{ 'app.email.verification.intro'|trans }} <br><br>
    <a href="{{ signedUrl|raw }}">{{ 'app.email.verification.link'|trans }}</a>.
    {{ 'app.email.verification.expires'|trans({'%expires%': expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle')}) }}
</p>

<p>
    {{ 'app.email.cheers'|trans }}
</p>
