{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ 'app.admin.map_images.page'|trans }}{% endblock %}

{% block admin_body %}
    <h1>{{ 'app.admin.map_images.page'|trans }}</h1>

    <p class="text-body-secondary">{{ 'app.admin.map_images.help'|trans }}</p>

    <div class="card mb-4">
        <div class="card-body">
            {{ form_start(uploadForm) }}
                {{ form_row(uploadForm.image) }}
                <button type="submit" class="btn btn-primary">
                    {{ ux_icon('bi:upload', {class: 'me-1'}) }}
                    {{ 'app.admin.map_images.upload'|trans }}
                </button>
            {{ form_end(uploadForm) }}
        </div>
    </div>

    {% if files is empty %}
        <p class="text-body-secondary">{{ 'app.admin.map_images.none'|trans }}</p>
    {% else %}
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">{{ 'app.admin.uploads.file'|trans }}</th>
                    <th scope="col">{{ 'app.admin.map_images.used_by'|trans }}</th>
                    <th scope="col">{{ 'app.admin.uploads.size'|trans }}</th>
                    <th scope="col">{{ 'app.admin.uploads.modified'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for file in files %}
                    <tr class="map-image-row">
                        <td>
                            <img src="{{ asset(file.url) }}" alt="" class="rounded me-2" style="max-width: 96px; max-height: 96px;">
                            <code>{{ file.filename }}</code>
                        </td>
                        <td>{{ file.owner ?? '—' }}</td>
                        <td>{{ file.size|number_format }} bytes</td>
                        <td>{{ file.modifiedAt|format_datetime('medium', 'short') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <p class="text-body-secondary small">{{ 'app.admin.map_images.remove_hint'|trans }}</p>
    {% endif %}
{% endblock %}
