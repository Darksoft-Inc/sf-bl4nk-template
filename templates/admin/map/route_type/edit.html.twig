{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ 'app.admin.map.route_type.edit_page'|trans }}{% endblock %}

{% block admin_body %}
    <h1>{{ 'app.admin.map.route_type.edit_page'|trans }}: {{ map.name }}</h1>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.color) }}
        <button type="submit" class="btn btn-primary">{{ 'app.admin.user.save'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
