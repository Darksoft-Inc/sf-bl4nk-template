{% extends 'base.html.twig' %}

{% block title %}{{ 'app.page.check_email'|trans }}{% endblock %}

{% block body %}
    <p>
        {{ 'app.reset_password.check_email.sent'|trans }}
        {{ 'app.reset_password.check_email.expires'|trans({'%expires%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}
    </p>
    <p>{{ 'app.reset_password.check_email.not_received'|trans }} <a href="{{ path('app_forgot_password_request') }}">{{ 'app.reset_password.check_email.try_again'|trans }}</a>.</p>
{% endblock %}
