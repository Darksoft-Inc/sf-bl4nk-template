{% extends 'base.html.twig' %}

{% block title %}{{ 'app.page.reset_password'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'app.page.reset_password'|trans }}</h1>

    {{ form_start(resetForm) }}
        {{ form_row(resetForm.plainPassword) }}
        <button class="btn btn-primary">{{ 'app.reset_password.reset'|trans }}</button>
    {{ form_end(resetForm) }}
{% endblock %}
