{% do email.setSubject('app.email.reset.subject'|trans) %}
<h1>{{ 'app.email.greeting'|trans }}</h1>

<p>{{ 'app.email.reset.intro'|trans }}</p>

<a href="{{ url('app_reset_password', {token: resetToken.token}) }}">{{ url('app_reset_password', {token: resetToken.token}) }}</a>

<p>{{ 'app.email.reset.expires'|trans({'%expires%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')}) }}</p>

<p>{{ 'app.email.cheers'|trans }}</p>
