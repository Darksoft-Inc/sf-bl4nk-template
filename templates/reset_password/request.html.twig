{% extends 'base.html.twig' %}

{% block title %}{{ 'app.page.reset_password'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'app.page.reset_password'|trans }}</h1>

    {{ form_start(requestForm) }}
        {{ form_row(requestForm.email) }}
        <div>
            <small>
                {{ 'app.reset_password.request_help'|trans }}
            </small>
        </div>

        <button class="btn btn-primary">{{ 'app.reset_password.send_email'|trans }}</button>
    {{ form_end(requestForm) }}
{% endblock %}
