{% extends 'base.html.twig' %}

{% block title %}{{ page.title|trans }}{% endblock %}

{% block body %}
    <main>
        <h1 class="reference-title">{{ page.title|trans }}</h1>

        <p class="text-body-secondary">{{ page.summary|trans }}</p>

        {% if page.details is not empty %}
            <dl class="row reference-details">
                {% for detail in page.details %}
                    <dt class="col-sm-3 col-lg-2">{{ detail.label|trans }}</dt>
                    <dd class="col-sm-9 col-lg-10">{{ detail.text|trans }}</dd>
                {% endfor %}
            </dl>
        {% endif %}

        {% if relatedPages is not empty %}
            <h2 class="h5 mt-4">{{ 'app.reference.related'|trans }}</h2>
            <ul class="reference-related list-unstyled">
                {% for related in relatedPages %}
                    <li>
                        <a href="{{ path('app_reference_show', {slug: related.slug}) }}">{{ related.title|trans }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <div class="mt-4">
            <a class="btn btn-secondary" href="{{ path('app_reference_index') }}">
                {{ ux_icon('bi:arrow-left', {class: 'me-1'}) }}
                {{ 'app.reference.back'|trans }}
            </a>
        </div>
    </main>
{% endblock %}
