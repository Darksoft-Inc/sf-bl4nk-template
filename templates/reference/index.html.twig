{% extends 'base.html.twig' %}

{% block title %}{{ 'app.page.reference'|trans }}{% endblock %}

{% block body %}
    <main>
        <h1>{{ 'app.page.reference'|trans }}</h1>

        {% if groups is empty %}
            <p class="reference-empty text-body-secondary">{{ 'app.reference.none'|trans }}</p>
        {% else %}
            {% for group, pages in groups %}
                {% if group %}<h2 class="h4 mt-4">{{ group|trans }}</h2>{% endif %}
                <ul class="list-group mb-3">
                    {% for page in pages %}
                        <li class="list-group-item">
                            <a class="reference-link fw-semibold" href="{{ path('app_reference_show', {slug: page.slug}) }}">{{ page.title|trans }}</a>
                            <div class="text-body-secondary">{{ page.summary|trans }}</div>
                        </li>
                    {% endfor %}
                </ul>
            {% endfor %}
        {% endif %}
    </main>
{% endblock %}
