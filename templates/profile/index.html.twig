{% extends 'base.html.twig' %}

{% block title %}{{ 'app.page.profile'|trans }}{% endblock %}

{% block body %}
<main>
    <h1>{{ 'app.page.profile'|trans }}</h1>

    <dl>
        <dt>{{ 'app.account.email'|trans }}</dt>
        <dd>{{ user.email }}</dd>

        <dt>{{ 'app.account.email_verification'|trans }}</dt>
        <dd>{{ user.verified ? 'app.account.verified'|trans : 'app.account.not_verified'|trans }}</dd>

        <dt>{{ 'app.account.last_connection'|trans }}</dt>
        <dd class="user-last-connection">
            {% if user.lastConnectedAt %}
                {{ 'app.account.last_connection_at'|trans({'%date%': user.lastConnectedAt|format_datetime('medium', 'short')}) }}
                {% if user.lastIp %}
                    {{ 'app.account.last_connection_from'|trans({'%ip%': user.lastIp}) }}
                {% endif %}
            {% else %}
                {{ 'app.account.never_connected'|trans }}
            {% endif %}
        </dd>
    </dl>

    <h2>{{ 'app.account.avatar'|trans }}</h2>

    {% if user.avatarFilename %}
        <img class="avatar mb-3 rounded" src="{{ asset('uploads/avatars/' ~ user.avatarFilename) }}" alt="{{ 'app.account.avatar'|trans }}" style="max-width: {{ avatarDisplayMax }}px; max-height: {{ avatarDisplayMax }}px;">
    {% endif %}

    {{ form_start(avatarForm) }}
        {{ form_row(avatarForm.avatar) }}
        <button type="submit" class="btn btn-primary">{{ 'app.avatar.save'|trans }}</button>
    {{ form_end(avatarForm) }}

    <h2>{{ 'app.account.change_password'|trans }}</h2>

    {{ form_start(changePasswordForm) }}
        {{ form_row(changePasswordForm.plainPassword) }}
        <button type="submit" class="btn btn-primary">{{ 'app.account.change_password'|trans }}</button>
    {{ form_end(changePasswordForm) }}
</main>
{% endblock %}
