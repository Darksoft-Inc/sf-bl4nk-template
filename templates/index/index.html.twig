{% extends 'base.html.twig' %}

{% block title %}Start{% endblock %}

{% block body %}
<main>
    <h1>Start</h1>

    <ul>
        {% if app.user %}
            <li><a href="{{ path('app_profile') }}">Profile</a></li>
            <li><a href="{{ path('app_logout') }}">Log out</a></li>
        {% else %}
            <li><a href="{{ path('app_login') }}">Log in</a></li>
            <li><a href="{{ path('app_register') }}">Register</a></li>
            <li><a href="{{ path('app_forgot_password_request') }}">Reset your password</a></li>
        {% endif %}
    </ul>
</main>
{% endblock %}
