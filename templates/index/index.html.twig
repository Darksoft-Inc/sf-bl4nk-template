{% extends 'base.html.twig' %}

{% block title %}{{ 'app.page.start'|trans }}{% endblock %}

{% block body %}
<main>
    <h1>{{ 'app.page.start'|trans }}</h1>

    <ul>
        <li><a href="{{ path('app_announcement_index') }}">{{ 'app.navigation.announcements'|trans }}</a></li>
        {% if app.user %}
            <li><a href="{{ path('app_profile') }}">{{ 'app.navigation.profile'|trans }}</a></li>
            <li><a href="{{ path('app_logout') }}">{{ 'app.navigation.logout'|trans }}</a></li>
        {% else %}
            <li><a href="{{ path('app_login') }}">{{ 'app.navigation.login'|trans }}</a></li>
            <li><a href="{{ path('app_register') }}">{{ 'app.navigation.register'|trans }}</a></li>
            <li><a href="{{ path('app_forgot_password_request') }}">{{ 'app.navigation.reset_password'|trans }}</a></li>
        {% endif %}
    </ul>
</main>
{% endblock %}
