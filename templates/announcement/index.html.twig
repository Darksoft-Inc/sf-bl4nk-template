{% extends 'base.html.twig' %}

{% block title %}{{ 'app.page.announcements'|trans }}{% endblock %}

{% block body %}
    <main>
        <h1>{{ 'app.page.announcements'|trans }}</h1>

        <div class="mb-4">
            {{ form_start(searchForm) }}
                <div class="row g-2 align-items-end">
                    <div class="col-md-8">
                        {{ form_row(searchForm.announcement) }}
                    </div>
                    <div class="col-md-4 d-grid d-md-block">
                        <button type="submit" class="btn btn-primary">
                            {{ ux_icon('bi:search', {'class': 'me-1'}) }}
                            {{ 'app.announcement.search.go'|trans }}
                        </button>
                    </div>
                </div>
            {{ form_end(searchForm) }}
        </div>

        {% if announcements is empty %}
            <p class="announcement-empty text-body-secondary">{{ 'app.announcement.none'|trans }}</p>
        {% else %}
            <ul class="list-group">
                {% for announcement in announcements %}
                    <li class="list-group-item">
                        <a class="announcement-link fw-semibold" href="{{ path('app_announcement_show', {id: announcement.id}) }}">{{ announcement.title }}</a>
                        <div class="text-body-secondary d-inline-flex align-items-center">
                            {{ ux_icon('bi:calendar-event', {'class': 'me-1'}) }}
                            <span>{{ announcement.publishedAt|format_datetime('medium', 'none') }}</span>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
{% endblock %}
